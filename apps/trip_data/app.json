{
  "id": "trip_data",
  "title": "Trip Data",
  "description": "Vehicle trip recording with a driving dashboard and trip history",
  "version": "1.9.0",
  "vendor": "custom",
  "loggingId": "OA9F",
  "iconGlyph": "TRIP",
  "autostart": true,
  "signals": {
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_instances": "Main_Instance",
      "rawPositionData": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineStatus": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "Drive-readiness trip boundaries",
      "VehicleCondition": "s",
      "vehicleConditionNoCrc": "s"
    },
    "de.bmw.infotainment.lifecycle.lifecycle.Lifecycle": {
      "_instances": "Front",
      "_optional": "Head-unit power-off trip boundaries",
      "powerStateDetailed": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "Range": "s",
      "DataPowerTrain2": "s",
      "statusGearboxDrive": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Trip Data",
      "graphic": "MAIN_GFX",
      "buttons": [
        ["BTN_RECORD", "Start trip"],
        ["BTN_SETTINGS", "Browse"]
      ]
    },
    {
      "name": "SETTINGS",
      "kind": "list",
      "title": "Trip Data settings",
      "parent": "MAIN",
      "items": [
        ["text3", "BROWSE_INFO", "Choose a page"],
        ["button", "BROWSE_0", ""],
        ["button", "BROWSE_1", ""],
        ["button", "BROWSE_2", ""],
        ["button", "BROWSE_3", ""],
        ["button", "BROWSE_4", ""],
        ["button", "BROWSE_5", ""],
        ["button", "BROWSE_6", ""],
        ["button", "BROWSE_7", ""],
        ["button", "BROWSE_8", ""],
        ["button", "BROWSE_9", ""],
        ["button", "PREF_AUTO", "Auto-start trips"],
        ["button", "PREF_SMOOTH", "Smooth graphs"],
        ["button", "PREF_SECTION", "Startup page"],
        ["button", "PREF_DEMO", "Demo data"],
        ["button", "PREF_RETRY", "Reconnect vehicle data"],
        ["text", "PREF_STORAGE", "Trip storage"],
        ["text3", "PREF_NOTICE", "Trips end when drive readiness ends."]
      ]
    }
  ]
}
