{
  "id": "trip_data",
  "title": "Trip Data",
  "description": "Trip dashboard with vehicle-style tabs, trip history and independent recording recovery",
  "version": "1.7.0",
  "vendor": "custom",
  "loggingId": "OA9F",
  "iconGlyph": "TRIP",
  "signals": {
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_instances": "Main_Instance",
      "rawPositionData": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineStatus": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "Range": "s",
      "DataPowerTrain2": "s",
      "statusGearboxDrive": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Trip Data",
      "graphic": "MAIN_GFX",
      "buttons": [
        ["BTN_RECORD", "Start trip"],
        ["BTN_CURRENT", "Current trip"],
        ["BTN_OPTIONS", "Options"],
        ["BTN_BACK", "Back"],
        ["BTN_SETTINGS", "Settings"]
      ]
    },
    {
      "name": "SETTINGS",
      "kind": "list",
      "title": "Trip Data settings",
      "parent": "MAIN",
      "items": [
        [
          "text3",
          "PREF_FIXED",
          "US units / 3 decimal measurement places / 12-hour dates. Moving means above 1 mph; stationary periods stay recorded."
        ],
        [
          "button",
          "PREF_DEMO",
          "Demo data"
        ],
        [
          "button",
          "PREF_DETAIL",
          "Recording interval"
        ],
        [
          "button",
          "PREF_AUTO",
          "Automatic engine-session recording"
        ],
        [
          "button",
          "PREF_ALTITUDE",
          "Elevation noise deadband"
        ],
        [
          "button",
          "PREF_SMOOTH",
          "Display graph smoothing"
        ],
        [
          "text3",
          "PREF_BANDS",
          "Speed bands: 10 mph increments"
        ],
        [
          "text3",
          "PREF_STORAGE",
          ""
        ],
        [
          "text3",
          "PREF_NOTICE",
          ""
        ],
        [
          "button",
          "PREF_RETRY",
          "Retry vehicle providers"
        ],
        [
          "button",
          "PREF_BACK",
          "Back to dashboard"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "demo", "label": "Demo data", "type": "choice", "default": "off",
      "options": [["off", "Off"], ["on", "On (not recorded)"]]
    },
    {
      "key": "section", "label": "Initial page", "type": "choice", "default": "trip",
      "options": [["trip", "Trip"], ["elevation", "Elevation"], ["fuel", "Fuel"], ["gears", "Gears"], ["history", "History"]]
    }
  ]
}
