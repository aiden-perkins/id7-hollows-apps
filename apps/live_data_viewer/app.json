{
  "id": "live_data_viewer",
  "title": "Live Data Viewer",
  "description": "Performance meters with visual extrema, compact driving instruments, rolling temperatures and eight-cylinder engine-health comparison",
  "version": "1.5.0",
  "vendor": "custom",
  "loggingId": "OA9E",
  "iconGlyph": "LIVE",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusStandstillFunctions": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusDSCSwitchHMI": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "basicDataSet": "s"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_instances": "Main_Instance",
      "rawPositionData": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.XView": {
      "statusSteeringAngleDriver": "rs"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.TPMSInternalData": {
      "tpmsInternalLastValues": "rs"
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Live Data Viewer",
      "graphic": "MAIN_GFX",
      "bar": false,
      "buttons": []
    },
    {
      "name": "PREFERENCES",
      "kind": "list",
      "title": "Settings",
      "parent": "MAIN",
      "items": [
        [
          "text3",
          "PREF_FIXED",
          ""
        ],
        [
          "button",
          "PREF_DEMO",
          "Demo data"
        ],
        [
          "button",
          "PREF_TREND",
          "Recent graph window"
        ],
        [
          "button",
          "PREF_RATE",
          "Refresh preference"
        ],
        [
          "button",
          "PREF_ORDER",
          "Category order"
        ],
        [
          "text3",
          "PREF_NOTES",
          ""
        ],
        [
          "text3",
          "PREF_NOTICE",
          ""
        ],
        [
          "button",
          "PREF_HOME",
          "Back to dashboard"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "demo", "label": "Demo data", "type": "choice", "default": "off",
      "options": [["off", "Off"], ["on", "On (simulated)"]]
    },
    {
      "key": "section", "label": "Initial page", "type": "choice", "default": "driving",
      "options": [["driving", "Driving"], ["temperatures", "Temperatures"], ["health", "Engine health"]]
    }
  ]
}
