{
  "id": "live_data_viewer",
  "title": "Live Data Viewer",
  "description": "Performance meters, front/rear active anti-roll dynamics, rolling temperatures and eight-cylinder engine-health comparison",
  "version": "1.7.3",
  "vendor": "custom",
  "loggingId": "OA9E",
  "iconGlyph": "LIVE",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusStandstillFunctions": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusDSCSwitchHMI": "rs",
      "statusActualValueTorque2": "rs",
      "statusSwitchDriveDynamicSport2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "basicDataSet": "s"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_instances": "Main_Instance",
      "rawPositionData": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.XView": {
      "statusSteeringAngleDriver": "rs"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.TPMSInternalData": {
      "tpmsInternalLastValues": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Live Data Viewer",
      "graphic": "MAIN_GFX",
      "bar": false,
      "buttons": [["BTN_SETTINGS", "Settings"]]
    }
  ],
  "settings": [
    {
      "key": "demo", "label": "Demo data", "type": "choice", "default": "off",
      "options": [["off", "Off"], ["on", "On (simulated)"]]
    },
    {
      "key": "demoDriveMode", "label": "Demo driving mode", "type": "choice", "default": "SPORT EXPERT",
      "options": [["SPORT EXPERT", "Sport"], ["COMFORT", "Comfort"], ["ECO PRO EFFICIENT", "Eco Pro"]]
    },
    {
      "key": "section", "label": "Initial page", "type": "choice", "default": "driving",
      "options": [["driving", "Driving"], ["dynamics", "Dynamics"], ["temperatures", "Temperatures"], ["health", "Engine health"]]
    },
    {
      "key": "refreshMs", "label": "Getter refresh", "type": "number", "unit": "ms", "default": 100,
      "steps": [100, 250, 500, 1000, 2000]
    },
    {
      "key": "boostSource", "label": "Boost source", "type": "choice", "default": "auto",
      "options": [["auto", "Auto (sport display, then DME)"], ["fes", "Sport display"], ["dme", "Engine unit (DME)"]]
    },
    {
      "key": "boostNote", "label": "Boost updates", "type": "text",
      "default": "M Vitals sources; immediate sport-display notifications; 100 ms getter / DME target, not guaranteed"
    },
    {
      "key": "trendSeconds", "label": "Recent graph window", "type": "number", "unit": "s", "default": 180,
      "steps": [60, 180, 600]
    },
    {
      "key": "categoryOrder", "label": "Category order", "type": "choice", "default": "driving,dynamics,temperatures,health",
      "options": [
        ["driving,dynamics,temperatures,health", "Driving / Dynamics / Temperatures / Engine health"],
        ["driving,dynamics,health,temperatures", "Driving / Dynamics / Engine health / Temperatures"],
        ["temperatures,driving,dynamics,health", "Temperatures / Driving / Dynamics / Engine health"],
        ["temperatures,health,driving,dynamics", "Temperatures / Engine health / Driving / Dynamics"],
        ["health,driving,dynamics,temperatures", "Engine health / Driving / Dynamics / Temperatures"],
        ["health,temperatures,driving,dynamics", "Engine health / Temperatures / Driving / Dynamics"]
      ]
    },
    {
      "key": "displayNote", "label": "Display", "type": "text",
      "default": "Up to 60 FPS; US units; fuel L then G, two decimals"
    },
    {
      "key": "fuelNote", "label": "Fuel percentage", "type": "text",
      "default": "Total litres / nominal 68 L M850i tank; graphical reference, not ECU-reported capacity"
    },
    {
      "key": "samplingNote", "label": "Sampling", "type": "text",
      "default": "Only the visible category collects live readings"
    },
    {
      "key": "pedalNote", "label": "Pedals", "type": "text",
      "default": "50 ms target; ECU latency and shared queue limit replies"
    },
    {
      "key": "brakeNote", "label": "Brake", "type": "text",
      "default": "Pressure, not pedal percent; parking brake from Vehicle2"
    },
    {
      "key": "kickdownNote", "label": "Kickdown", "type": "text",
      "default": "DME digital switch; never inferred from pedal position"
    },
    {
      "key": "slowNote", "label": "Slower readings", "type": "text",
      "default": "Fuel 5 s; battery 2 s; TPMS at least 5 s"
    },
    {
      "key": "exhaustNote", "label": "Exhaust controls", "type": "text",
      "default": "Manual requests only; highlight is not measured position"
    },
    {
      "key": "modelNote", "label": "Temperature models", "type": "text",
      "default": "Exhaust and transfer-clutch models are labelled"
    },
    {
      "key": "missingNote", "label": "Unsupported readings", "type": "text",
      "default": "Front / rear delivered power unknown; no torque-split estimate"
    },
    {
      "key": "sessionNote", "label": "Min / max", "type": "text",
      "default": "This app session only"
    },
    {
      "key": "demoNote", "label": "Demo safety", "type": "text",
      "default": "Simulated values; exhaust requests disabled"
    },
    {
      "key": "lastError", "label": "Last error", "type": "text", "default": "None"
    }
  ]
}
