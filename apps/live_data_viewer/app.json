{
  "id": "live_data_viewer",
  "title": "Live Data Viewer",
  "description": "Driving dynamics, Car Status and a dual-DME BM3 channel grid",
  "version": "1.10.3",
  "vendor": "custom",
  "loggingId": "OA9E",
  "iconGlyph": "LIVE",
  "config": { "settingsPreferencesOnly": true },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "statusStandstillFunctions": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusDSCSwitchHMI": "rs",
      "statusActualValueTorque2": "rs",
      "statusSwitchDriveDynamicSport2": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "basicDataSet": "s"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "Driving shift RPM markers",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_instances": "Main_Instance",
      "rawPositionData": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.XView": {
      "statusSteeringAngleDriver": "rs"
    },
    "de.bmw.chassis.SteeringAngle": {
      "_optional": "Driving steering notifications",
      "ActualSteeringAngleDriver": "s",
      "actualSteeringAngleDriverNoCRC": "s",
      "SteeringAngleFrontAxleEffective": "s"
    },
    "de.bmw.infotainment.vehicle.A4A": {
      "_optional": "Driving brake status notifications",
      "statusA4AFDRControl": "s"
    },
    "de.bmw.powertrain.Powertrain": {
      "_optional": "Driving wheel speed notifications",
      "ActualValueRPMWheel": "s"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "_optional": "Driving accelerator notifications",
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "statusTargetTyrePressure": "rs"
    },
    "de.bmw.infotainment.vehicle.TPMSInternalData": {
      "tpmsInternalLastValues": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Live Data Viewer",
      "graphic": "MAIN_GFX",
      "bar": false,
      "buttons": [["BTN_SETTINGS", "Settings"]]
    }
  ],
  "settings": [
    {
      "key": "colorTheme", "label": "Theme", "type": "choice", "default": "carbon_track",
      "options": [
        ["carbon_track", "Carbon Track"],
        ["black_gold", "Black & Gold"],
        ["neon_rally", "Neon Rally"],
        ["blackened_copper", "Blackened Copper"],
        ["obsidian_violet", "Obsidian Violet"]
      ]
    },
    {
      "key": "section", "label": "Initial page", "type": "choice", "default": "driving",
      "options": [["driving", "Driving"], ["status", "Car Status"], ["bm3", "BM3 channels"]]
    },
    {
      "key": "bm3Engine", "label": "BM3 engine family (confirm exact family)", "type": "choice", "default": "unset",
      "options": [
        ["unset", "Not selected - BM3 acquisition disabled"],
        ["N63", "N63"], ["N63T2", "N63T2"], ["N63T3", "N63T3"],
        ["S63", "S63"], ["S63T4", "S63T4"], ["S63T4-1", "S63T4-1"], ["S63T4-2", "S63T4-2"],
        ["B36-MEVD1723", "B36-MEVD1723"], ["B38-MEVD1723", "B38-MEVD1723"], ["B38-T0", "B38-T0"],
        ["B42", "B42"], ["B46", "B46"], ["B48", "B48"], ["B48-MEVD1723", "B48-MEVD1723"], ["B58", "B58"],
        ["N13", "N13"], ["N20", "N20"], ["N26", "N26"], ["N47", "N47"], ["N55", "N55"], ["N57", "N57"],
        ["N74T2", "N74T2"], ["S55", "S55"], ["S58", "S58"], ["S58-1", "S58-1"], ["S58-2", "S58-2"]
      ]
    },
    {
      "key": "boostSource", "label": "Boost source", "type": "choice", "default": "auto",
      "options": [["auto", "Auto (sport display, then DME)"], ["fes", "Sport display"], ["dme", "Engine unit (DME)"]]
    },
    {
      "key": "trendSeconds", "label": "Recent graph window", "type": "number", "unit": "s", "default": 180,
      "steps": [180, 600]
    }
  ]
}
